# Optional PrivaProxy service overrides.
# Keep secrets in this root-owned file; do not place them in the release tree.
#
# PRIVAPROXY_BASE_PATH=/privaproxy
# PRIVAPROXY_PASSWORD=change-me
# PRIVAPROXY_ACCOUNTS=1
# PRIVAPROXY_DATA_DIR=/var/lib/privaproxy/accounts
# XDG_CACHE_HOME=/var/lib/privaproxy/accounts/cache
# PRIVASEARCH_URL=http://127.0.0.1:4020
# PRIVASEARCH_TOKEN=change-me
# YTDLP_PATH=/usr/local/bin/yt-dlp
