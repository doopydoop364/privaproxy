{
  "name": "privaproxy",
  "version": "1.2.0",
  "description": "Self-hosted privacy browser and YouTube client",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "start": "node server/index.js",
    "build:portable": "node scripts/build-portable.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@mercuryworkshop/bare-as-module3": "^2.2.5",
    "@mercuryworkshop/bare-mux": "^2.1.9",
    "@mercuryworkshop/scramjet": "^1.1.0",
    "@titaniumnetwork-dev/ultraviolet": "^3.2.10",
    "@tomphttp/bare-server-node": "^2.0.6",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "hls.js": "^1.7.3"
  },
  "allowScripts": {
    "@mercuryworkshop/scramjet@1.1.0": true
  },
  "bin": {
    "privaproxy": "bin/privaproxy.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin/*.js",
    "server/*.js",
    "server/proxies/*.js",
    "server/youtube/*.js",
    "server/config/proxies.json",
    "public/index.html",
    "public/css/*.css",
    "public/js/*.js",
    "public/uv/*.js",
    "public/scramjet/*.js"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/doopydoop364/privaproxy.git"
  }
}
